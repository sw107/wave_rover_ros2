<?xml version="1.0"?>
<robot name="wave_rover" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- 차체 크기 상수 정의 (단위: m) -->
  <xacro:property name="base_length" value="0.250"/>
  <xacro:property name="base_width"  value="0.168"/>
  <xacro:property name="base_height" value="0.139"/>

  <!-- 타이어 크기 상수 정의 -->
  <xacro:property name="wheel_radius" value="0.040"/>
  <xacro:property name="wheel_width"  value="0.0425"/>

  <!-- base_footprint: 로봇 바닥 기준점 -->
  <!-- Nav2 표준에서 권장하는 로봇 기준 좌표계 -->
  <link name="base_footprint"/>

  <!-- base_footprint → base_link 연결 -->
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
  </joint>

  <!-- base_link: 차체 중심 -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="silver">
        <color rgba="0.7 0.7 0.7 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
    <inertial>
      <!-- 차체 무게: 860g -->
      <mass value="0.860"/>
      <inertia
        ixx="0.003" ixy="0.0" ixz="0.0"
        iyy="0.004" iyz="0.0"
        izz="0.005"/>
    </inertial>
  </link>

  <!-- laser: LiDAR 위치 -->
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="laser"/>
    <origin xyz="0.062 0 0.135" rpy="0 0 0"/>
  </joint>

  <link name="laser">
    <visual>
      <geometry>
        <cylinder radius="0.04" length="0.06"/>
      </geometry>
      <material name="black">
        <color rgba="0.0 0.0 0.0 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.04" length="0.06"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.170"/>
      <inertia
        ixx="0.0001" ixy="0.0" ixz="0.0"
        iyy="0.0001" iyz="0.0"
        izz="0.0001"/>
    </inertial>
  </link>

</robot>
